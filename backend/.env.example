APP_NAME=THREATLENS API
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required for URL scan persistence; keep this backend-only.
SUPABASE_SECRET_KEY=
# Legacy fallback; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Optional backend-only OpenRouter provider. Generate your own key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=REPLACE_WITH_NEW_OPENROUTER_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=THREATLENS
LLM_REQUEST_TIMEOUT_SECONDS=15
PASSPORT_SCANNER_VERSION=0.1.0
PASSPORT_REPORT_VERSION=1.0
URL_SCAN_MAX_URL_LENGTH=2048
URL_SCAN_CONNECT_TIMEOUT_SECONDS=3
URL_SCAN_TOTAL_TIMEOUT_SECONDS=15
URL_SCAN_JOB_TIMEOUT_SECONDS=60
URL_SCAN_MAX_RESPONSE_BYTES=16384
URL_SCAN_MAX_REDIRECTS=5
URL_SCAN_SUSPICIOUS_SCORE=25
URL_SCAN_HIGH_RISK_SCORE=60
URL_SCAN_WEIGHT_PUNYCODE=22
URL_SCAN_WEIGHT_DEEP_SUBDOMAIN=12
URL_SCAN_WEIGHT_SENSITIVE_PATH=10
URL_SCAN_WEIGHT_HTTP=12
URL_SCAN_WEIGHT_REDIRECT_LIMIT=20
URL_SCAN_WEIGHT_REDIRECT_CHAIN=15
URL_SCAN_WEIGHT_BLOCKED_REDIRECT=60
URL_SCAN_CONFIRMED_MIN_CONFIDENCE=0.95
URL_SCAN_TRUSTED_THREAT_SOURCES=urlhaus,openphish,phishtank,threatfox,google-safe-browsing

